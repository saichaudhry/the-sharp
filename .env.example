# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# On Vercel, add the same three names under Project -> Settings -> Environment Variables.

# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Supabase -> Project Settings -> API (server-only; never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# https://the-odds-api.com (free tier). Leave blank to use built-in demo odds.
ODDS_API_KEY=
