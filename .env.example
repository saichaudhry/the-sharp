# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.
# (Prices come from Kalshi's public API and stats from ESPN's; neither needs a key.)

# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Supabase -> Project Settings -> API (server-only; never expose the secret key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
